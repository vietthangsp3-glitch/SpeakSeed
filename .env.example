# Optional. One server-side key only; SpeakSeed does not rotate keys to evade quota.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Keep disabled until one explicitly authorized real-API preview test succeeds.
GEMINI_LIVE_ENABLED=false
# Vercel Hobby functions are limited to 300 seconds; leave shutdown headroom.
GEMINI_LIVE_MAX_SECONDS=240
GEMINI_LIVE_MAX_AUDIO_BYTES=28000000
# Exact public hostname, without scheme/path. It is always added to both the
# TrustedHost and same-origin CSRF/CORS allowlists.
PRIMARY_HOST=speak-seed.vercel.app
# Optional extra exact aliases. Never use * or include https:// here.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_ENV=development
# Generate a random value of at least 32 characters. Mandatory in production.
APP_SECRET=change-this-before-production-at-least-32-characters
AUTH_TRANSPORT=cookie
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
# Comma-separated IPs/CIDRs of the direct reverse proxy. Forwarding headers from
# every other peer are ignored even when TRUST_PROXY_HEADERS=true.
TRUSTED_PROXY_IPS=127.0.0.1,::1
DB_PATH=./speakseed.db
# After a separately verified migration, DATABASE_URL overrides DB_PATH:
# DATABASE_URL=postgresql://user:password@postgres:5432/speakseed
# On Vercel, use the provider's serverless/pooled PostgreSQL URL. DATABASE_URL
# is mandatory there; DB_PATH is deliberately rejected.
LOG_LEVEL=INFO
# Optional Azure word-level pronunciation assessment
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Legacy audio cache is retained for rollback/audit, but /api/tts is disabled.
# Non-Live playback uses the browser Web Speech API and never calls Gemini.
# TTS_CACHE_DIR=./audio_cache
# Configure current provider rates to enable cost estimates. Zero means unknown,
# not free. Text units are approximate tokens. The TTS rate remains only for
# interpreting historical usage rows created before browser-only speech.
GEMINI_INPUT_USD_PER_MILLION=0
GEMINI_OUTPUT_USD_PER_MILLION=0
GEMINI_TTS_USD_PER_MILLION_CHARS=0
